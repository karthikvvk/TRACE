# Friday — environment variables
# Copy to .env and fill in your values.

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Browser bridge ────────────────────────────────────────────────────────────
EXTENSION_SECRET=change-me-in-production
ALLOW_SCRIPT_EXECUTION=false

# ── Colab Brain Offload (optional) ────────────────────────────────────────────
# Set COLAB_SECRET to a strong random string and paste it in colab_brain.ipynb Cell 2.
# Set COLAB_MODE=true to route /chat through the Colab brain when connected.
# Leave COLAB_MODE=false (default) to always use the local agent.
COLAB_SECRET=colab-change-me
COLAB_MODE=false
