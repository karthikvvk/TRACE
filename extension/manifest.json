{
  "manifest_version": 3,
  "name": "Friday",
  "version": "0.1.0",
  "description": "Your local-first browser agent. Friday watches, remembers, and reminds — without the cloud.",

  "permissions": [
    "tabs",
    "history",
    "webNavigation",
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "sidePanel",
    "cookies"
  ],

  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "ws://localhost:8000/*",
    "ws://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/observer.js", "content/bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "side_panel": {
    "default_path": "sidepanel/index.html"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Friday"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
